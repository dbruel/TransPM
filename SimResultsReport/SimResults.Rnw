<<result-table-sample-size, echo=FALSE, results='asis'>>=
load("../results/tables/ResultsSampleSize.RData")
sim.results |>
  filter(measure!="CITL") |> 
  mutate(
    "95\\% quantiles" = apply(cbind(lower, upper), 1, formatCI, digits = 3),
    outcome = recode(outcome,
                     UKDCD_dichot = "UK DCD")
  ) |>
  dplyr::select(outcome, sample_size, measure, median, `95\\% quantiles`, n_sim, MCse) |>
  arrange(outcome, sample_size) |>
  rename(
    "Outcome" = outcome,
    "$n$" = sample_size,
    "Performance measure" = measure,
    "Median" = median,
    "$n_\\text{sim}$" = n_sim
  ) |> 
  kable(format = "latex", digits = 3, booktabs = TRUE, longtable = TRUE, escape = FALSE,
        caption = "Simulation results of the variation of the sample size used ($n$) in the target population. The median over all simulations for each condition together with the 2.5\\% and 97.5\\% quantiles as well as the Monte Carlo standard error (MCse) are reported.",
        label = "sim-results-sample-size") |>
  kable_styling(font_size = 9)
  # collapse_rows(1:3, valign = "top", longtable_clean_cut = FALSE)
