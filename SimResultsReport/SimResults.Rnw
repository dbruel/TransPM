\documentclass[11pt, a4paper]{article}

\usepackage{booktabs}
\usepackage{longtable}
\usepackage{makecell}
\usepackage[T1]{fontenc}
\usepackage[utf8]{inputenc}
\usepackage[british]{babel}
\usepackage{lmodern}
\usepackage[margin=2.5cm]{geometry}
\usepackage{xcolor}
\usepackage{amsmath}

\renewcommand{\thetable}{Results-\arabic{table}}

\begin{document}

<<setup, include=FALSE>>=
library(tidyverse)
library(kableExtra)
library(biostatUZH)
@

\section*{Detailed numerical simulation results}

<<result-table-age, echo=FALSE, results='asis'>>=
load("../results/tables/ResultsAgeShift.RData")
sim.results |>
  filter(measure!="CITL") |> 
  mutate(
    "95\\% quantiles" = apply(cbind(lower, upper), 1, formatCI, digits = 3),
    outcome = recode(outcome,
                     UKDCD_dichot = "UK DCD")
  ) |>
  dplyr::select(outcome, d.age, r.age, measure, median, `95\\% quantiles`, n_sim, MCse) |>
  arrange(outcome, d.age, r.age) |>
  rename(
    "Outcome" = outcome,
    "$\\mu_\\text{D.age}$" = d.age,
    "$\\mu_\\text{R.age}$" = r.age,
    "Performance measure" = measure,
    "Median" = median,
    "$n_\\text{sim}$" = n_sim
  ) |> 
  kable(format = "latex", digits = 3, booktabs = TRUE, longtable = TRUE, escape = FALSE,
        caption = "Simulation results of the variation of mean recipient and donor age ($\\mu_\\text{R.age}$ and $\\mu_\\text{D.age}$) in the target population. The median over all simulations for each condition together with the 2.5\\% and 97.5\\% quantiles as well as the Monte Carlo standard error (MCse) are reported.",
        label = "sim-results-age") |>
  kable_styling(font_size = 7)
  # collapse_rows(1:3, valign = "top", longtable_clean_cut = FALSE)
@
\newpage
<<result-table-fwit-cit, echo=FALSE, results='asis'>>=
load("../results/tables/ResultsFWIT-CIT.RData")
sim.results |> 
  filter(measure!="CITL") |> 
  mutate(
    "95\\% quantiles" = apply(cbind(lower, upper), 1, formatCI, digits = 3),
    outcome = recode(outcome,
                     UKDCD_dichot = "UK DCD")
  ) |>
  dplyr::select(outcome, FWIT, CITg6, measure, median, `95\\% quantiles`, n_sim, MCse) |>
  arrange(outcome, FWIT, CITg6) |>
  rename(
    "Outcome" = outcome,
    "$\\mu_\\text{FWIT}$" = FWIT,
    "$p_{\\text{CIT}>6\\text{h}}$" = CITg6,
    "Performance measure" = measure,
    "Median" = median,
    "$n_\\text{sim}$" = n_sim
  ) |> 
  kable(format = "latex", digits = 3, booktabs = TRUE, longtable = TRUE, escape = FALSE,
        caption = "Simulation results of the variation of mean functional donor warm ischaemia time ($\\mu_\\text{FWIT}$) and proportion of cold ischaemia time greater than 6 hours ($p_{\\text{CIT}>6\\text{h}}$) in the target population. The median over all simulations for each condition together with the 2.5\\% and 97.5\\% quantiles as well as the Monte Carlo standard error (MCse) are reported.",
        label = "sim-results-fwit-cit") |>
  kable_styling(font_size = 7)
  # collapse_rows(1:3, valign = "top", longtable_clean_cut = FALSE)
@
\newpage
<<result-table-retp, echo=FALSE, results='asis'>>=
